<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <PawnKindDef Name="ESCP_VampireKindBase" Abstract="True">
        <race>Human</race>
        <defaultFactionDef>ESCP_Faction_Volkihar</defaultFactionDef>
        <xenotypeSet>
            <xenotypeChances>
                <ESCP_Xenotype_Nord MayRequire="Rick.ESCP.Nords">0.45</ESCP_Xenotype_Nord>
                <ESCP_Xenotype_Imperial MayRequire="Rick.ESCP.Imperials">0.2</ESCP_Xenotype_Imperial>
                <ESCP_Xenotype_Breton MayRequire="Rick.ESCP.Bretons">0.15</ESCP_Xenotype_Breton>
                <ESCP_Xenotype_Dunmer MayRequire="Rick.ESCP.Dunmer">0.1</ESCP_Xenotype_Dunmer>
                <ESCP_Xenotype_Redguard MayRequire="Rick.ESCP.Redguards">0.1</ESCP_Xenotype_Redguard>
            </xenotypeChances>
        </xenotypeSet>
        <useFactionXenotypes>false</useFactionXenotypes>
        <minGenerationAge>20</minGenerationAge>
        <maxGenerationAge>60</maxGenerationAge>
        <chemicalAddictionChance>0</chemicalAddictionChance>
        <invNutrition>2</invNutrition>
        <invFoodDef>Pemmican</invFoodDef>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
        <disallowedTraits>
            <li>Kind</li>
            <li>Wimp</li>
        </disallowedTraits>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_Vampire_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_Vampire_Adult</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_VampireKindBase">
        <defName>ESCP_Pawnkind_Vampire_Thrall</defName>
        <backstoryFiltersOverride Inherit="False">
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_Vampire_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_Vampire_Thrall</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <label>vampire thrall</label>
        <combatPower>40</combatPower>
        <isFighter>true</isFighter>
        <itemQuality>Poor</itemQuality>
        <gearHealthRange>0.4~1.0</gearHealthRange>
        <apparelMoney>150~350</apparelMoney>
        <apparelTags>
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
        </apparelTags>
        <weaponMoney>100~300</weaponMoney>
        <weaponTags>
            <li>MedievalMeleeBasic</li>
            <li>MedievalRanged</li>
        </weaponTags>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>8~14</initialResistanceRange>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_VampireKindBase">
        <defName>ESCP_Pawnkind_Vampire_Fledgling</defName>
        <label>fledgling vampire</label>
        <combatPower>70</combatPower>
        <isFighter>true</isFighter>
        <itemQuality>Normal</itemQuality>
        <apparelMoney>250~500</apparelMoney>
        <apparelTags>
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
        </apparelTags>
        <weaponMoney>200~400</weaponMoney>
        <weaponTags>
            <li>MedievalMeleeBasic</li>
            <li>MedievalMeleeDecent</li>
        </weaponTags>
        <skills>
            <li>
                <skill>Melee</skill>
                <range>6~10</range>
            </li>
        </skills>
        <initialWillRange>3~5</initialWillRange>
        <initialResistanceRange>18~26</initialResistanceRange>
        <modExtensions>
            <li Class="ESCP.Core.Vampires.PawnKindExtension_Vampire" />
        </modExtensions>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_VampireKindBase">
        <defName>ESCP_Pawnkind_Vampire</defName>
