        <combatPower>90</combatPower>
        <isFighter>true</isFighter>
        <itemQuality>Normal</itemQuality>
        <apparelMoney>400~900</apparelMoney>
        <apparelTags>
            <li>MedievalBasic</li>
            <li>MedievalMilitaryBasic</li>
        </apparelTags>
        <weaponMoney>300~700</weaponMoney>
        <weaponTags>
            <li>MedievalMeleeDecent</li>
        </weaponTags>
        <skills>
            <li>
                <skill>Melee</skill>
                <range>8~14</range>
            </li>
            <li>
                <skill>Intellectual</skill>
                <range>5~10</range>
