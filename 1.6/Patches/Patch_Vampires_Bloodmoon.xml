<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Mashed's Bloodmoon</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/HediffDef[defName="ESCP_Hediff_Vampirism"]/stages/li/statOffsets</xpath>
                    <value>
                        <Mashed_Bloodmoon_LycanthropyResistance>1</Mashed_Bloodmoon_LycanthropyResistance>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/HediffDef[defName="Mashed_Bloodmoon_Lycanthrope"]/stages/li/makeImmuneTo</xpath>
                    <value>
                        <li>ESCP_Hediff_SanguinareVampiris</li>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>
