                <randomSpells>
                    <li>ESCP_Spell_IceSpike</li>
                    <li>ESCP_Spell_Paralyze</li>
                    <li>ESCP_Spell_Invisibility</li>
                </randomSpells>
                <randomCount>1~1</randomCount>
            </li>
        </modExtensions>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_VampireKindBase">
