        </modExtensions>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_VampireKindBase">
        <defName>ESCP_Pawnkind_Vampire_Elder</defName>
        <label>vampire elder</label>
        <combatPower>130</combatPower>
        <isFighter>true</isFighter>
        <minGenerationAge>30</minGenerationAge>
        <itemQuality>Good</itemQuality>
        <apparelMoney>800~1400</apparelMoney>
        <apparelTags>
            <li>MedievalMilitaryAdvanced</li>
        </apparelTags>
        <weaponMoney>500~900</weaponMoney>
        <weaponTags>
            <li>MedievalMeleeDecent</li>
            <li>MedievalMeleeAdvanced</li>
        </weaponTags>
        <skills>
            <li>
                <skill>Melee</skill>
                <range>10~16</range>
            </li>
            <li>
                <skill>Intellectual</skill>
                <range>8~14</range>
            </li>
        </skills>
        <initialWillRange>6~9</initialWillRange>
        <initialResistanceRange>35~50</initialResistanceRange>
        <modExtensions>
            <li Class="ESCP.Core.Vampires.PawnKindExtension_Vampire" />
            <li Class="ESCP.Core.Magic.PawnKindExtension_Spellcaster">
                <spells>
                    <li>ESCP_Spell_Fear</li>
